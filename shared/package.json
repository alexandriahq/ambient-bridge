{
  "name": "@ambient/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./app-icon-builder": "./scripts/app-icon-builder.mjs",
    "./announcements": {
      "types": "./src/announcements.ts",
      "default": "./src/announcements.ts"
    },
    "./feature-flags": {
      "types": "./src/feature-flags.ts",
      "default": "./src/feature-flags.ts"
    },
    "./icon-file": "./scripts/icon-file.mjs",
    "./inference-models": {
      "types": "./src/inference-models.d.ts",
      "default": "./src/inference-models.js"
    },
    "./macos-app-icon": "./scripts/macos-app-icon.cjs",
    "./local-secret-vault": {
      "types": "./src/local-secret-vault.ts",
      "default": "./src/local-secret-vault.ts"
    },
    "./macos-trash": {
      "types": "./src/macos-trash.ts",
      "default": "./src/macos-trash.ts"
    },
    "./product-version": {
      "types": "./src/product-version.ts",
      "default": "./src/product-version.ts"
    },
    "./server-targets": {
      "types": "./src/server-targets.ts",
      "default": "./src/server-targets.ts"
    },
    "./silent-mode": {
      "types": "./src/silent-mode.ts",
      "default": "./src/silent-mode.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css",
    "./utils": {
      "types": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./utils.js": {
      "types": "./src/utils.ts",
      "default": "./src/utils.ts"
    },
    "./components/*": {
      "types": "./src/components/*.svelte",
      "svelte": "./src/components/*.svelte",
      "default": "./src/components/*.svelte"
    },
    "./ui/*/index.js": {
      "types": "./src/ui/*/index.ts",
      "svelte": "./src/ui/*/index.ts",
      "default": "./src/ui/*/index.ts"
    },
    "./ui/*": {
      "types": "./src/ui/*/index.ts",
      "svelte": "./src/ui/*/index.ts",
      "default": "./src/ui/*/index.ts"
    },
    "./notifications": {
      "types": "./src/notifications/index.ts",
      "svelte": "./src/notifications/index.ts",
      "default": "./src/notifications/index.ts"
    },
    "./observability": {
      "types": "./src/observability/index.ts",
      "default": "./src/observability/index.ts"
    },
    "./update-core": {
      "types": "./src/update-core.ts",
      "default": "./src/update-core.ts"
    },
    "./usage": {
      "types": "./src/usage.ts",
      "default": "./src/usage.ts"
    },
    "./window-capture": {
      "types": "./src/window-capture.ts",
      "default": "./src/window-capture.ts"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/stix-two-text": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.27.0",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.8",
    "@alexandria/cloud-contract": "workspace:*"
  },
  "devDependencies": {
    "shadcn-svelte": "^1.4.2",
    "typescript": "^5.8.3",
    "@types/node": "^25.3.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
